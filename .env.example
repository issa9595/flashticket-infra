# Copier en .env puis `source .env` avant de travailler (ou : source .env.example).
# Identifiants factices et adresse de LocalStack pour l'AWS CLI.
export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=eu-west-3

# L'AWS CLI v1 ignore AWS_ENDPOINT_URL pour SQS : cette fonction ajoute --endpoint-url à chaque
# commande `aws` de ce terminal, quelle que soit la version de l'AWS CLI.
# Pour revenir à un vrai compte AWS : unset -f aws ; unset AWS_ENDPOINT_URL
aws() { command aws --endpoint-url "$AWS_ENDPOINT_URL" "$@"; }
export -f aws 2>/dev/null || true
