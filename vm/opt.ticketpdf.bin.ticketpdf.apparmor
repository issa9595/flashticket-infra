# À installer sous /etc/apparmor.d/opt.ticketpdf.bin.ticketpdf (sans le suffixe .apparmor)
#include <tunables/global>

/opt/ticketpdf/bin/ticketpdf {
  #include <abstractions/base>

  network inet stream,
  network inet6 stream,

  /opt/ticketpdf/bin/ticketpdf mr,
  /var/lib/ticketpdf/** rw,
  /etc/ticketpdf/tls/* r,
}
